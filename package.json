{
  "name": "eu-tax-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI tax advisor for European cross-border workers and digital nomads (ES/PT/DE/NL/UK)",
  "scripts": {
    "dev": "wrangler dev --local --persist-to=./.wrangler/state",
    "dev:remote": "wrangler dev --remote",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply eu-tax-saas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply eu-tax-saas-db --remote",
    "db:studio": "drizzle-kit studio",
    "extract:acroform": "tsx tools/extract-acroform-fields.ts",
    "ingest:form-mappings": "tsx scripts/ingest-form-mappings.ts"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "@solidjs/start": "^1.1.4",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.6.20",
    "pdf-lib": "^1.17.1",
    "solid-js": "^1.9.4",
    "vinxi": "^0.5.3",
    "yaml": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.103.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.5.1",
  "lint-staged": {
    "*.{ts,tsx,json}": ["biome check --write"]
  }
}
